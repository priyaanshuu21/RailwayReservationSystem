# RailNexus local development environment.
# Copy to .env and adjust. Never commit the real .env file.

# --- Oracle (primary / authoritative store) ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
# Docker (gvenzl/oracle-free) exposes service FREEPDB1; local XE uses XE.
ORACLE_SERVICE=FREEPDB1
# Admin account used by scripts/dev-setup to create schemas and run DDL.
# Docker gvenzl default: system / <ORACLE_SYS_PASSWORD you set in docker-compose>
# Local 11g XE default: system / <password chosen at install>
ORACLE_ADMIN_USER=system
ORACLE_ADMIN_PASSWORD=railnexus_sys
ORACLE_USER=RAILNEXUS
ORACLE_PASSWORD=railnexus_dev
# Zone schemas used by the distributed zone router
ORACLE_USER_NORTH=RAILNEXUS_NORTH
ORACLE_USER_WEST=RAILNEXUS_WEST
ORACLE_USER_SOUTH=RAILNEXUS_SOUTH
ORACLE_ZONE_PASSWORD=railnexus_dev
# Minimum pool sizes for node-oracledb thick/thin driver
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
# Set to "false" to boot the API without Oracle (readiness reports down, data endpoints 503)
ORACLE_ENABLED=true

# --- Redis (cache, distributed lock, session store) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true

# --- MongoDB (semi-structured audit, templates, analytics) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=railnexus
MONGO_ENABLED=true

# --- API ---
API_PORT=4000
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Shared header key used by non-browser clients (scripts, curl demos). Browser clients use JWT.
API_KEY=dev-api-key-change-me
# JWT secrets: generate long random strings for anything outside local dev
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
